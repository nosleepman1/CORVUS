# ==============================================================================
# 🦅 Configuration de l'Agent Corvus
# ==============================================================================

# Clé API DeepSeek (Obligatoire pour les appels au modèle)
# Obtenez votre clé sur https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Base URL de l'API DeepSeek (Par défaut: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modèle de code et de chat rapide (Par défaut: deepseek-chat)
CORVUS_MODEL=deepseek-chat

# Modèle de raisonnement architectural profond (Par défaut: deepseek-reasoner)
CORVUS_REASONER_MODEL=deepseek-reasoner

# Mode de permission : 'default' (demander pour écrire/bash), 'plan' (valider le plan une fois), 'bypass' (tout autoriser)
CORVUS_PERMISSION_MODE=default

# Port du serveur Bridge WebSocket Daemon (pour l'application Desktop GUI)
CORVUS_DAEMON_PORT=3080

# Niveau de journalisation ('debug', 'info', 'warn', 'error')
CORVUS_LOG_LEVEL=info
